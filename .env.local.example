# Pi Console Mac 本地部署配置
# 复制为 .env.local 并填入真实值

# ===== 必填 =====
GLM_API_KEY=your-glm-api-key-here
PI_API_TOKEN=your-secret-token-here
WORKER_SECRET=your-worker-secret-here

# ===== 数据库 =====
POSTGRES_DB=pi_console
POSTGRES_USER=pi
POSTGRES_PASSWORD=changeme-use-openssl-rand-hex-16

# ===== GLM API =====
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-5.1

# ===== Worker =====
WORKER_POLL_INTERVAL=5000

# ===== Redis =====
REDIS_PASSWORD=changeme-use-openssl-rand-hex-16

# ===== 搜索（可选） =====
# SEARXNG_URL=http://searxng:8080

# ===== 时区 =====
TZ=Asia/Shanghai
