# Pi Console - 环境变量
# 复制为 .env 并填入真实值

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pi_console
POSTGRES_USER=pi
POSTGRES_PASSWORD=pi_local_dev

# FastAPI
API_HOST=0.0.0.0
API_PORT=7001
WORKER_SECRET=change-me-in-production

# GLM API
GLM_API_KEY=your-glm-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-5.1

# Node Worker
WORKER_POLL_INTERVAL=5000

# 本地开发（不用 Docker 时）使用 SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./pi_console.db
# Docker 部署时 DATABASE_URL 由 docker-compose.yml 自动设置
